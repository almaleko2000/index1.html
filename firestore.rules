rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'hNwwH6TTtHSlUmanfAQPYSBtMqd2';
    }

    match /slides/{slideId} {
      // Visitors can only read slides marked as active.
      allow read: if resource.data.active == true || isAdmin();
      // Only the registered administrator can change slide data.
      allow create, update, delete: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /processSteps/{stepId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /siteContent/{contentId} {
      // This document contains public page text only.
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
